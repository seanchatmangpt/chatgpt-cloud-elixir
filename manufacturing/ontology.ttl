@prefix cc: <https://chatman.ai/chatgpt-cloud/capability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cc:CapabilitySource a prov:Entity .
cc:ManufacturingCapsule a prov:Entity .
cc:ObservationScope a prov:Entity .
cc:CONSTRUCT_VERIFY a odrl:Permission ; skos:prefLabel "CONSTRUCT_VERIFY" .

cc:AutonomicManufacturingCapsule a cc:ManufacturingCapsule ;
  dcterms:title "ChatGPT Cloud Autonomic Manufacturing Capsule" ;
  dcterms:identifier "autonomic-manufacturing" ;
  cc:releaseVersion "26.9.23" ;
  cc:authorityCeiling cc:CONSTRUCT_VERIFY ;
  cc:requiresExternalExecution true ;
  cc:lfsObjectPolicy "pointer-identity" ;
  cc:observationScope cc:OwnerPublicCatalog ;
  cc:includesSource cc:Ggen, cc:GgenMarketplace, cc:GgenCreate, cc:GgenLegacy, cc:GgenSpecKit, cc:SwarmSH,
    cc:SwarmSHV2, cc:GgenEcosystem, cc:ChatmanEcosystem, cc:GymEcosystem, cc:GgenIgniter, cc:GgenSkills,
    cc:AgileProtocolSpecification, cc:ClapNounVerb, cc:Unjucks, cc:Gitvan, cc:Dspygen, cc:OpenOntologies,
    cc:Unrdf, cc:Xaas, cc:AshSurface, cc:AshA2a, cc:AshPplan, cc:AshExpo,
    cc:AshPlanningCenter, cc:AshSupabase, cc:AshEx4pm, cc:AshR2rml, cc:Beam4pm, cc:Ex4pm,
    cc:Wasm4pm, cc:Wasm4pmCompat, cc:Pm4wasm, cc:ProcessIntelligence, cc:Mfact, cc:Autotel,
    cc:Gymact, cc:AutofdeLab, cc:Autofde, cc:Ferroplan, cc:Fdegym, cc:Sregym,
    cc:Lifegym, cc:Ww3gym, cc:Rrgym, cc:Biblegym, cc:Chatgptgym, cc:Claudecodegym,
    cc:AwesomeAiGyms, cc:Affidavit, cc:Truex, cc:Clnrm, cc:ChicagoTddTools, cc:LspMax,
    cc:AntiLlmCheatLsp, cc:CargoCicd, cc:Bcinr, cc:FrozenDuckdb, cc:EngineeringStandards, cc:ZcodeCli, cc:Rust4pm, cc:AshKudzu,
    cc:KoalaPlanner, cc:Zoela, cc:Mmdio .

# Admission is a subset of observation. Every public repository owned by
# seanchatmangpt is in observation scope; only the enumerated cc:CapabilitySource
# members below are admitted into the capsule at exact SHAs. Private repositories
# are deliberately never named here: observation authority is not publication
# authority. Refresh admitted SHAs with scripts/refresh-capability-sources.py.
cc:OwnerPublicCatalog a cc:ObservationScope ;
  dcterms:title "Public GitHub repository catalog for seanchatmangpt" ;
  cc:repositoryPredicate "owner=seanchatmangpt AND visibility=public" ;
  cc:admissionRule "observation-not-admission" ;
  cc:privateIdentityProjection false ;
  dcterms:source <https://github.com/seanchatmangpt/ggen-ecosystem/blob/main/ontology/github-catalog.ttl> .

cc:Ggen a cc:CapabilitySource ;
  skos:prefLabel "ggen" ;
