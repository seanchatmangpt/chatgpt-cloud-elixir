  cc:commitSha "233e23bfc894fe9da8bfabbaedad7277ef485362" ;
  cc:role "deterministic semantic manufacturing engine" ;
  cc:capitalClass "manufacturing-runtime" ;
  cc:executionMode "compiled-binary" ;
  cc:requiredStanding "exact-source-build-and-replay" ;
  cc:admissionBasis "manufacturing-core" .

