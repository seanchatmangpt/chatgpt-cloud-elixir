@prefix cce:<https://seanchatman.github.io/chatgpt-cloud-elixir/paas#>. @prefix sh:<http://www.w3.org/ns/shacl#>. @prefix xsd:<http://www.w3.org/2001/XMLSchema#>. cce:SnapshotRestoreShape a sh:NodeShape;sh:targetClass cce:RuntimeInvocation;cce:projectNumber 2;cce:ocelPath "ggen/ecosystem/ocel/current";cce:acceptanceEdge "snapshot_restore";cce:semanticFingerprint "sha256:b5ec49e55ffde5d502b2e018b4f5971ed2d91dd7553859d1c47efde8d021338d";cce:ambientExecutionAuthority false;sh:property[sh:path cce:snapshotDigest;sh:minCount 1;sh:maxCount 1;sh:datatype xsd:string;sh:pattern "^sha256:[0-9a-f]{64}$";sh:message "Bind runtime snapshot restore identity"].