@prefix cce:<https://seanchatman.github.io/chatgpt-cloud-elixir/paas#>. @prefix sh:<http://www.w3.org/ns/shacl#>. @prefix xsd:<http://www.w3.org/2001/XMLSchema#>. cce:ConfigSnapshotShape a sh:NodeShape; sh:targetClass cce:RuntimeInvocation; cce:projectNumber 2; cce:ocelPath "ggen/ecosystem/ocel/current"; cce:acceptanceEdge "config_snapshot"; cce:semanticFingerprint "sha256:51a6a71d299851469192b5d1364277a851922b96888009c73c32273a968bd15e"; cce:ambientExecutionAuthority false; sh:property[sh:path cce:configSnapshotDigest;sh:minCount 1;sh:maxCount 1;sh:datatype xsd:string;sh:pattern "^sha256:[0-9a-f]{64}$";sh:message "Bind immutable runtime config snapshot"].