@prefix cce:<https://seanchatman.github.io/chatgpt-cloud-elixir/paas#>. @prefix sh:<http://www.w3.org/ns/shacl#>. @prefix xsd:<http://www.w3.org/2001/XMLSchema#>. cce:WireDigestShape a sh:NodeShape;sh:targetClass cce:RuntimeInvocation;cce:projectNumber 2;cce:ocelPath "ggen/ecosystem/ocel/current";cce:acceptanceEdge "wire_digest";cce:semanticFingerprint "sha256:639a20360f7ee83d344d3dd5e0bb2adb4eb939f291cade2eb2ba48528407f69a";cce:ambientExecutionAuthority false;sh:property[sh:path cce:wirePayloadDigest;sh:minCount 1;sh:maxCount 1;sh:datatype xsd:string;sh:pattern "^sha256:[0-9a-f]{64}$";sh:message "Bind wire payload digest"].