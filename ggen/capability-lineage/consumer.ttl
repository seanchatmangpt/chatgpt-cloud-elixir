@prefix clc: <https://ggen.dev/ontology/capability-lineage-consumer#> .

clc:chatgpt-cloud-elixir a clc:Consumer ;
  clc:repository "seanchatmangpt/chatgpt-cloud-elixir" ;
  clc:exactBase "5c3452b0775de940784456aa6079fefd830cbe30" ;
  clc:sourcePack "capability-lineage-propagation-pack" ;
  clc:authority "SELECT|CONSTRUCT|VERIFY" ;
