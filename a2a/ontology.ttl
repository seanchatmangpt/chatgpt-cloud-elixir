@prefix a2a:  <https://github.com/seanchatmangpt/chatgpt-cloud-elixir/a2a#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Semantic A2A over git refs ("gitgrok"): ephemeral instances that can only make
# outbound connections rendezvous on GitHub. Each agent writes only its own
# outbox ref; peers read by fetching. GitHub push authorization is the
# authentication boundary; the per-agent hash chain is the integrity boundary.

a2a:Agent        a rdfs:Class ; rdfs:comment "An addressable agent bound to exactly one outbox ref." .
a2a:AgentCard    a rdfs:Class ; rdfs:comment "Self-description: id, outbox ref, skills, authority fence." .
a2a:Skill        a rdfs:Class ; rdfs:comment "A named, bounded capability an agent will perform on request." .
a2a:Message      a rdfs:Class ; rdfs:comment "Content-addressed, hash-chained speech act from one agent." .
a2a:Performative a rdfs:Class ; rdfs:comment "FIPA-ACL style illocutionary force of a message." .

a2a:request a a2a:Performative .
a2a:inform  a a2a:Performative .
a2a:agree   a a2a:Performative .
a2a:refuse  a a2a:Performative .
a2a:failure a a2a:Performative .

a2a:outboxRef    rdfs:domain a2a:AgentCard ; rdfs:range xsd:string .
a2a:hasSkill     rdfs:domain a2a:AgentCard ; rdfs:range a2a:Skill .
a2a:from         rdfs:domain a2a:Message   ; rdfs:range a2a:Agent .
a2a:to           rdfs:domain a2a:Message   ; rdfs:range a2a:Agent .
a2a:seq          rdfs:domain a2a:Message   ; rdfs:range xsd:nonNegativeInteger .
a2a:prev         rdfs:domain a2a:Message   ; rdfs:comment "sha256 id of the sender's previous message (null at genesis)." .
a2a:inReplyTo    rdfs:domain a2a:Message   ; rdfs:range a2a:Message .
a2a:conversation rdfs:domain a2a:Message   ; rdfs:range xsd:string .
a2a:performative rdfs:domain a2a:Message   ; rdfs:range a2a:Performative .
a2a:skill        rdfs:domain a2a:Message   ; rdfs:range a2a:Skill .

# Transports and discovery (capabilities left UNKNOWN by the first receipt).
a2a:Transport      a rdfs:Class ; rdfs:comment "How an agent reads and appends its outbox ref; every transport yields the same commits and ledger." .
a2a:GitTransport   a a2a:Transport ; rdfs:comment "git binary + clone; plumbing commit pushed without force." .
a2a:ApiTransport   a a2a:Transport ; rdfs:comment "HTTPS-only GitHub REST git data API; fast-forward-only ref update (force: false)." .
a2a:DiscoveryIndex a rdfs:Class ; rdfs:comment "Advisory directory of agent cards in GitHub Project v2 #2, carried by the project-memory proxy. Hint only; never authority." .
a2a:indexedIn      rdfs:domain a2a:AgentCard ; rdfs:range a2a:DiscoveryIndex .
a2a:cardDigest     rdfs:domain a2a:AgentCard ; rdfs:comment "sha256 of the canonical card, as recorded in the index." .
